# ==========================================
# Google Gemini & Google ADK Configuration
# ==========================================
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AGENT_TEMPERATURE=0.2
MAX_RETRIES=3

# Set to true to force deterministic mock execution without calling Gemini API
MOCK_LLM=false

# ==========================================
# Application Configuration
# ==========================================
APP_ENV=development
DEBUG=true
PORT=8000
API_SECRET_KEY=change-this-secret-key-in-production

# ==========================================
# Persistence Configuration (SQLite by default, Supabase optional)
# ==========================================
SQLITE_DB_PATH=data/mediator.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==========================================
# CORS Configuration (for Figma Make / Frontend)
# ==========================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","*"]

# ==========================================
# Slack Bolt & Socket Mode Configuration
# ==========================================
# Get your Slack App credentials from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_DEFAULT_CHANNEL=#general
DASHBOARD_BASE_URL=http://localhost:8000

# ==========================================
# n8n Automation Webhook Configuration
# ==========================================
N8N_WEBHOOK_URL=https://dtakang.app.n8n.cloud/webhook/mediator-decision
N8N_WEBHOOK_SECRET=dev-mediator-key-123

